page {
  min-height: 100%;
  background: #f4eadc;
  color: #2f332f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button::after {
  border: 0;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 28rpx 60rpx;
  background:
    radial-gradient(circle at 100% 0%, rgba(137, 157, 134, 0.16), transparent 34%),
    linear-gradient(180deg, #f8f1e8 0%, #efe3d4 100%);
}

.card {
  box-sizing: border-box;
  width: 100%;
  padding: 32rpx;
  border: 1rpx solid rgba(80, 83, 74, 0.13);
  border-radius: 10rpx;
  background: rgba(255, 252, 246, 0.92);
  box-shadow: 0 18rpx 48rpx rgba(63, 52, 41, 0.08);
}

.primary-button,
.secondary-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  margin: 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.primary-button {
  color: #fffaf1;
  background: linear-gradient(135deg, #7f2f36, #54252a);
  box-shadow: 0 14rpx 32rpx rgba(92, 42, 43, 0.22);
}

.secondary-button {
  color: #4d5a50;
  border: 1rpx solid rgba(69, 81, 72, 0.24);
  background: rgba(255, 252, 246, 0.82);
}

.section-title {
  margin: 0 0 20rpx;
  color: #3e463f;
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: #817d73;
}

.error-card {
  margin-top: 22rpx;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  color: #8b3338;
  background: #f8e9e6;
  font-size: 26rpx;
  line-height: 1.6;
}
