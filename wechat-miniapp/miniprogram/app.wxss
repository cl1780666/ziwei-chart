page {
  min-height: 100%;
  background: #fff7fb;
  color: #392a3c;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button::after {
  border: 0;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 28rpx 60rpx;
  background:
    radial-gradient(circle at 10% 0%, rgba(249, 168, 212, 0.28), transparent 36%),
    radial-gradient(circle at 100% 18%, rgba(199, 175, 255, 0.25), transparent 30%),
    linear-gradient(180deg, #fff9fc 0%, #fff4f8 100%);
}

.card {
  box-sizing: border-box;
  width: 100%;
  padding: 32rpx;
  border: 1rpx solid rgba(169, 94, 137, 0.12);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 50rpx rgba(112, 60, 94, 0.09);
}

.primary-button,
.secondary-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  margin: 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.primary-button {
  color: #fff;
  background: linear-gradient(135deg, #d86aa5, #9c72db);
  box-shadow: 0 14rpx 32rpx rgba(192, 93, 151, 0.25);
}

.secondary-button {
  color: #8b4771;
  border: 1rpx solid rgba(169, 94, 137, 0.22);
  background: rgba(255, 255, 255, 0.82);
}

.section-title {
  margin: 0 0 20rpx;
  color: #5c3b5d;
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: #927d91;
}

.error-card {
  margin-top: 22rpx;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  color: #a23f62;
  background: #fff0f5;
  font-size: 26rpx;
  line-height: 1.6;
}
