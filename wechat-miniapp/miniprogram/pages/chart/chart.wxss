.loading-card { padding: 120rpx 0; color: #997f93; text-align: center; }
.chart-hero { text-align: center; }
.chart-hero text { display: block; }
.chart-kicker { color: #bd6c98; font-size: 21rpx; letter-spacing: 4rpx; }
.chart-title { margin-top: 14rpx; color: #583851; font-family: serif; font-size: 44rpx; font-weight: 700; }
.chart-date { margin-top: 12rpx; color: #947b8f; font-size: 25rpx; }
.tag-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 12rpx; margin-top: 24rpx; }
.tag { padding: 10rpx 18rpx; border-radius: 999rpx; color: #945e7e; background: #fff0f7; font-size: 23rpx; }
.correction-note { margin-top: 22rpx; padding: 16rpx; border-radius: 16rpx; color: #85677d; background: #fff8fb; font-size: 22rpx; line-height: 1.5; }

.summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 22rpx; }
.summary-item { padding: 24rpx; border-radius: 24rpx; background: rgba(255,255,255,.86); box-shadow: 0 12rpx 30rpx rgba(112,60,94,.06); }
.summary-item text { display: block; text-align: center; }
.summary-item text { color: #a08598; font-size: 22rpx; }
.summary-item .summary-strong { margin-top: 8rpx; color: #67455f; font-size: 30rpx; font-weight: 700; }

.palace-heading { display: block; margin: 38rpx 0 20rpx; }
.palace-list { display: flex; flex-direction: column; gap: 18rpx; }
.palace-card { padding: 26rpx; }
.palace-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.palace-name { color: #65425e; font-size: 31rpx; font-weight: 700; }
.body-mark { margin-left: 10rpx; padding: 5rpx 10rpx; border-radius: 999rpx; color: #fff; background: #a77bd6; font-size: 18rpx; }
.palace-meta { color: #aa91a3; font-size: 21rpx; }
.star-line { display: block; color: #765b70; font-size: 25rpx; line-height: 1.65; }
.star-line.minor { margin-top: 6rpx; color: #988092; font-size: 23rpx; }
.chat-button { margin-top: 34rpx; }
.edit-button { margin-top: 18rpx; }
