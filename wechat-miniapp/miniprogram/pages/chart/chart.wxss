.loading-card { padding: 120rpx 0; color: #777c73; text-align: center; }
.chart-hero { position: relative; padding-top: 26rpx; overflow: hidden; text-align: center; background: linear-gradient(160deg, rgba(255,252,246,.96), rgba(239,230,216,.92)); }
.chart-hero::after { content: ""; position: absolute; right: -44rpx; bottom: -62rpx; width: 210rpx; height: 130rpx; border: 20rpx solid rgba(82,98,87,.07); transform: rotate(-7deg); }
.chart-hero text { display: block; }
.chart-ribbon { display: flex; justify-content: space-between; margin: 0 -6rpx 26rpx; padding-bottom: 18rpx; border-bottom: 1rpx solid rgba(71,82,73,.17); color: #6d716a; font-size: 17rpx; letter-spacing: 3rpx; }
.chart-kicker { color: #81343a; font-family: "Songti SC", "STSong", serif; font-size: 21rpx; letter-spacing: 5rpx; }
.chart-title { margin-top: 16rpx; color: #37433c; font-family: "Songti SC", "STSong", serif; font-size: 44rpx; font-weight: 700; letter-spacing: 3rpx; }
.chart-date { margin-top: 13rpx; color: #7d7a72; font-size: 24rpx; }
.tag-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 10rpx; margin-top: 24rpx; }
.tag { padding: 9rpx 17rpx; border: 1rpx solid rgba(127,48,54,.15); border-radius: 2rpx; color: #754348; background: #f5e9e3; font-size: 22rpx; }
.correction-note { position: relative; z-index: 1; margin-top: 22rpx; padding: 16rpx; border-left: 4rpx solid #53645a; color: #666d66; background: rgba(244,237,227,.85); font-size: 22rpx; line-height: 1.5; }

.summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 20rpx; }
.summary-item { padding: 23rpx; border: 1rpx solid rgba(71,82,73,.1); border-radius: 6rpx; background: rgba(255,252,246,.86); box-shadow: 0 10rpx 26rpx rgba(63,52,41,.05); }
.summary-item text { display: block; color: #8b877e; font-size: 21rpx; text-align: center; }
.summary-item .summary-strong { margin-top: 8rpx; color: #48544c; font-family: "Songti SC", "STSong", serif; font-size: 30rpx; font-weight: 700; }

.palace-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 38rpx 2rpx 18rpx; padding-bottom: 14rpx; border-bottom: 1rpx solid rgba(71,82,73,.18); }
.palace-heading .section-title { margin: 0; }
.heading-note { color: #8d877e; font-size: 18rpx; letter-spacing: 2rpx; }
.palace-list { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.palace-card { min-height: 208rpx; padding: 22rpx; }
.palace-head { display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 14rpx; }
.palace-head > view { display: flex; align-items: center; }
.palace-name { color: #3f4d44; font-family: "Songti SC", "STSong", serif; font-size: 29rpx; font-weight: 700; }
.body-mark { margin-left: 8rpx; padding: 4rpx 8rpx; border-radius: 2rpx; color: #fffaf1; background: #7f3036; font-size: 17rpx; }
.palace-meta { margin-top: 8rpx; color: #989188; font-size: 19rpx; }
.star-line { display: block; color: #646b64; font-size: 22rpx; line-height: 1.55; }
.star-line.minor { margin-top: 5rpx; color: #8a877f; font-size: 20rpx; }
.chat-button { margin-top: 30rpx; border-radius: 7rpx; letter-spacing: 4rpx; }
.edit-button { margin-top: 16rpx; border-radius: 7rpx; }
