.page-heading { margin: 4rpx 8rpx 28rpx; }
.page-heading text { display: block; }
.eyebrow { margin-bottom: 14rpx; color: #7f3036; font-size: 20rpx; letter-spacing: 5rpx; }
.intro { font-size: 24rpx; line-height: 1.7; }
.settings-card { padding: 28rpx; }
.field-label { display: block; color: #465148; font-size: 25rpx; font-weight: 600; }
.field-hint { display: block; margin-top: 10rpx; color: #91877a; font-size: 21rpx; line-height: 1.6; }
.quote-input { box-sizing: border-box; width: 100%; height: 160rpx; margin-top: 16rpx; padding: 18rpx 22rpx; border: 1rpx solid rgba(71,82,73,.2); border-radius: 6rpx; color: #4b554c; background: #f8f1e7; font-family: "Songti SC", serif; font-size: 28rpx; line-height: 1.7; }
.private-row { display: flex; align-items: center; gap: 16rpx; justify-content: space-between; margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(71,82,73,.12); }
.private-row > view { flex: 1; }
.private-row switch { flex-shrink: 0; }
.poster-wrap { margin: 32rpx auto 30rpx; width: 600rpx; max-width: 100%; }
.poster-image { display: block; width: 100%; box-shadow: 0 20rpx 50rpx rgba(55,54,42,.16); }
.poster-placeholder { display: flex; align-items: center; justify-content: center; min-height: 600rpx; border: 1rpx solid rgba(71,82,73,.15); color: #7e8275; background: #f8f1e6; font-family: serif; font-size: 28rpx; }
.poster-hint { display: block; margin-top: 18rpx; color: #948776; font-size: 21rpx; text-align: center; }
.primary-button { border-radius: 8rpx; }
.action-row { display: flex; gap: 16rpx; margin-top: 18rpx; }
.action-row button { flex: 1; min-width: 0; min-height: 82rpx; padding: 0 12rpx; border-radius: 8rpx; font-size: 24rpx; }
.share-note { margin: 20rpx 6rpx; }
.notice { color: #807a6f; font-size: 27rpx; line-height: 1.8; }
.notice button { margin-top: 24rpx; }
.export-canvas { position: fixed; left: -2000px; top: 0; pointer-events: none; }
