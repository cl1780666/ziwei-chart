.profile-page { padding-top: 0; }

.profile-masthead {
  position: relative;
  margin: 0 -28rpx 28rpx;
  padding: 54rpx 42rpx 38rpx;
  overflow: hidden;
  color: #f8f0e5;
  background: #3d493f;
}

.mast-image,
.mast-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.mast-shade { z-index: 1; background: linear-gradient(90deg, rgba(32,38,34,.82), rgba(36,40,35,.35)); }
.profile-masthead > text,
.mast-rule { position: relative; z-index: 2; }

.mast-kicker,
.mast-title,
.mast-copy { display: block; }
.mast-kicker { font-size: 19rpx; letter-spacing: 5rpx; opacity: .72; }
.mast-title { margin-top: 22rpx; font-family: "Songti SC", "STSong", serif; font-size: 54rpx; font-weight: 700; letter-spacing: 7rpx; }
.mast-copy { margin-top: 12rpx; font-family: "Songti SC", "STSong", serif; font-size: 24rpx; letter-spacing: 2rpx; opacity: .78; }
.mast-rule { display: flex; align-items: center; margin-top: 28rpx; }
.mast-rule::after { content: ""; flex: 1; height: 1rpx; margin-left: 14rpx; background: rgba(255,255,255,.28); }
.mast-rule text { display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; border: 1rpx solid rgba(255,255,255,.45); font-family: serif; font-size: 20rpx; }

.scene-card { position: relative; height: 260rpx; margin: 0 0 28rpx; overflow: hidden; border-radius: 8rpx; box-shadow: 0 16rpx 34rpx rgba(63,52,41,.12); }
.scene-image { width: 100%; height: 100%; }
.scene-caption { position: absolute; inset: auto 0 0; padding: 40rpx 24rpx 20rpx; color: #fff8ed; background: linear-gradient(transparent, rgba(34,31,27,.72)); }
.scene-caption text { display: block; }
.scene-caption text:first-child { font-family: "Songti SC", "STSong", serif; font-size: 27rpx; font-weight: 700; letter-spacing: 3rpx; }
.scene-caption text:last-child { margin-top: 5rpx; font-size: 18rpx; letter-spacing: 2rpx; opacity: .84; }

.form-card { padding: 38rpx 32rpx; }
.form-heading { margin-bottom: 34rpx; }
.form-heading text { display: block; }
.eyebrow { margin-bottom: 12rpx; color: #82333a; font-size: 19rpx; font-weight: 700; letter-spacing: 4rpx; }
.subtitle { font-size: 24rpx; line-height: 1.6; }

.field { margin-top: 28rpx; }
.field-label { color: #465148; font-size: 26rpx; font-weight: 600; }
.field-hint { margin-top: 10rpx; color: #918a80; font-size: 22rpx; line-height: 1.5; }
.block { display: block; }

.picker-value,
.text-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin-top: 12rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(71, 82, 73, .18);
  border-radius: 6rpx;
  background: #f8f1e7;
  color: #414a43;
  font-size: 27rpx;
}

.picker-value { display: flex; align-items: center; justify-content: space-between; }
.text-input { line-height: 88rpx; }
.gender-row { display: flex; gap: 16rpx; margin-top: 12rpx; }
.gender-option { display: flex; flex: 1; align-items: center; justify-content: center; min-height: 84rpx; border: 1rpx solid rgba(71,82,73,.15); border-radius: 6rpx; background: #faf4eb; }
.gender-option.selected { border-color: rgba(127,48,54,.45); background: #f4e8e3; }

.switch-row { display: flex; align-items: center; justify-content: space-between; margin-top: 30rpx; padding: 24rpx; border-left: 5rpx solid #53645a; background: #f5eee4; }
.save-button { margin-top: 38rpx; border-radius: 7rpx; letter-spacing: 3rpx; }
