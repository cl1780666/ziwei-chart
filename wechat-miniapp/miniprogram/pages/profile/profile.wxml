<view class="page-shell profile-page">
  <view class="profile-masthead">
    <image class="mast-image" src="/assets/wannan-autumn-tree.jpg" mode="aspectFill" />
    <view class="mast-shade"></view>
    <text class="mast-kicker">皖南 · 弦上星河</text>
    <text class="mast-title">生辰入谱</text>
    <text class="mast-copy">一纸徽墨，十二宫便有了来处。</text>
    <view class="mast-rule"><text>弦</text></view>
  </view>

  <view class="scene-card">
    <image class="scene-image" src="/assets/wannan-courtyard.jpg" mode="aspectFill" />
    <view class="scene-caption">
      <text>皖南一隅</text>
      <text>生辰入谱 · 山水为序</text>
    </view>
  </view>

  <view class="card form-card">
    <view class="form-heading">
      <text class="eyebrow">FOR LEI · 0819</text>
      <text class="section-title">写下你的出生信息</text>
      <text class="muted subtitle">资料与聊天只保存在这部手机，换手机不会同步。清缓存或卸载后会丢失。</text>
    </view>

    <view class="field">
      <text class="field-label">出生日期</text>
      <picker mode="date" value="{{date}}" start="1920-01-01" end="2035-12-31" bindchange="onDateChange">
        <view class="picker-value">{{date}} <text>›</text></view>
      </picker>
    </view>

    <view class="field">
      <text class="field-label">出生时辰</text>
      <picker range="{{shichenOptions}}" value="{{shichenIndex}}" bindchange="onShichenChange">
        <view class="picker-value">{{shichenOptions[shichenIndex]}} <text>›</text></view>
      </picker>
    </view>

    <view class="field">
      <text class="field-label">性别</text>
      <radio-group class="gender-row" bindchange="onGenderChange">
        <label class="gender-option {{gender === 'female' ? 'selected' : ''}}">
          <radio value="female" checked="{{gender === 'female'}}" color="#7f3036" />
          <text>女</text>
        </label>
        <label class="gender-option {{gender === 'male' ? 'selected' : ''}}">
          <radio value="male" checked="{{gender === 'male'}}" color="#526158" />
          <text>男</text>
        </label>
      </radio-group>
    </view>

    <view class="field">
      <text class="field-label">出生地（可选）</text>
      <input class="text-input" value="{{birthplace}}" placeholder="如：北京、成都、乌鲁木齐" bindinput="onBirthplaceInput" />
      <text class="field-hint">输入城市或区县后，会自动匹配经度并校正真太阳时。</text>
    </view>

    <view class="switch-row">
      <view>
        <text class="field-label">真太阳时校正</text>
        <text class="field-hint block">根据出生地自动处理</text>
      </view>
      <switch checked="{{trueSolarEnabled}}" color="#7f3036" bindchange="onTrueSolarChange" />
    </view>

    <button class="primary-button save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="save">
      {{saving ? '正在排盘…' : '落笔·查看命盘'}}
    </button>
    <text class="field-hint block">排盘时会临时发送出生资料；问答时会临时发送资料和最近对话，云端不保存这些内容。</text>
  </view>

  <view wx:if="{{error}}" class="error-card">{{error}}</view>
</view>
<music-control />
