<view class="chat-page">
  <view class="chat-header">
    <view>
      <text class="chat-title">弦外问星</text>
      <text class="chat-subtitle">一弦一答 · 今日余 {{remaining}} 问</text>
    </view>
    <button class="clear-button" bindtap="clearConversation">清空</button>
  </view>

  <view class="chat-scene">
    <image src="/assets/violin-rain-window.jpg" mode="aspectFill" />
    <view class="chat-scene-shade"></view>
    <text>雨落皖南 · 弦外慢聊</text>
  </view>

  <scroll-view class="message-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollTarget}}">
    <view id="chat-top"></view>
    <view class="welcome-bubble">
      <text class="avatar">弦</text>
      <view>
        <text class="bubble-name">星图先生 · 皖南</text>
        <text class="bubble-copy">命盘已经展开。想聊感情、事业或最近的运势，就像坐在水边一样，慢慢问。</text>
      </view>
    </view>

    <view wx:if="{{messages.length === 0}}" class="quick-list">
      <button wx:for="{{quickQuestions}}" wx:key="*this" class="quick-button" data-question="{{item}}" bindtap="askQuick">{{item}}</button>
    </view>

    <view wx:for="{{messages}}" wx:key="index" class="message-row {{item.role}}">
      <view class="message-bubble">
        <text selectable>{{item.content}}</text>
      </view>
    </view>

    <view wx:if="{{sending}}" class="message-row assistant">
      <view class="message-bubble thinking"><text>正在看盘</text><text class="dots">···</text></view>
    </view>
    <view wx:if="{{error}}" class="error-card chat-error">{{error}}</view>
    <view id="chat-bottom" class="chat-bottom"></view>
  </scroll-view>

  <view class="composer">
    <textarea class="question-input" value="{{question}}" placeholder="问一个具体的问题…" maxlength="500" auto-height bindinput="onInput" />
    <button class="send-button" disabled="{{sending || !question}}" bindtap="send">发送</button>
  </view>
</view>
