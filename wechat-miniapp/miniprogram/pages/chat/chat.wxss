.chat-page { display: flex; flex-direction: column; height: 100vh; background: #f3eadf; }
.chat-header { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx 20rpx; border-bottom: 1rpx solid rgba(71,82,73,.16); background: rgba(248,242,233,.96); }
.chat-title, .chat-subtitle { display: block; }
.chat-title { color: #3d493f; font-family: "Songti SC", "STSong", serif; font-size: 34rpx; font-weight: 700; letter-spacing: 3rpx; }
.chat-subtitle { margin-top: 6rpx; color: #89847b; font-size: 20rpx; }
.clear-button { margin: 0; padding: 9rpx 17rpx; border: 1rpx solid rgba(127,48,54,.17); border-radius: 3rpx; color: #7c373c; background: #f4e7e2; font-size: 21rpx; line-height: 1.4; }

.chat-scene { position: relative; flex: 0 0 150rpx; overflow: hidden; }
.chat-scene image,
.chat-scene-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.chat-scene-shade { background: linear-gradient(90deg, rgba(38,39,34,.56), rgba(38,39,34,.05)); }
.chat-scene text { position: absolute; left: 28rpx; bottom: 18rpx; color: #fff8ed; font-family: "Songti SC", "STSong", serif; font-size: 23rpx; font-weight: 700; letter-spacing: 4rpx; text-shadow: 0 2rpx 10rpx rgba(0,0,0,.3); }

.message-scroll { flex: 1; height: 0; padding: 24rpx 28rpx; box-sizing: border-box; background: radial-gradient(circle at 100% 5%, rgba(88,107,95,.09), transparent 32%); }
.privacy-note { display: block; margin-bottom: 22rpx; color: #89847b; font-size: 20rpx; line-height: 1.5; }
.welcome-bubble { display: flex; gap: 18rpx; margin-bottom: 24rpx; }
.avatar { display: flex; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; border: 1rpx solid rgba(255,255,255,.38); border-radius: 3rpx; color: #fff8ed; background: linear-gradient(145deg,#66786c,#3b4a41); font-family: serif; font-size: 23rpx; }
.bubble-name, .bubble-copy { display: block; }
.bubble-name { color: #697168; font-size: 20rpx; font-weight: 600; letter-spacing: 2rpx; }
.bubble-copy { max-width: 520rpx; margin-top: 8rpx; padding: 20rpx 22rpx; border: 1rpx solid rgba(71,82,73,.1); border-radius: 3rpx 18rpx 18rpx; color: #515a53; background: #fffaf2; box-shadow: 0 10rpx 26rpx rgba(63,52,41,.06); font-size: 25rpx; line-height: 1.7; }

.quick-list { display: flex; flex-direction: column; gap: 12rpx; margin: 8rpx 0 30rpx 84rpx; }
.quick-button { margin: 0; padding: 18rpx 22rpx; border: 1rpx solid rgba(71,82,73,.16); border-radius: 4rpx; color: #58645c; background: rgba(255,250,242,.84); font-size: 23rpx; line-height: 1.4; text-align: left; }

.message-row { display: flex; margin: 18rpx 0; }
.message-row.user { justify-content: flex-end; }
.message-row.assistant { justify-content: flex-start; }
.message-bubble { max-width: 78%; padding: 21rpx 24rpx; border-radius: 18rpx; font-size: 27rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-word; }
.user .message-bubble { border-bottom-right-radius: 3rpx; color: #fff8ed; background: linear-gradient(135deg,#81343a,#5d292d); }
.assistant .message-bubble { border: 1rpx solid rgba(71,82,73,.09); border-bottom-left-radius: 3rpx; color: #4f5851; background: #fffaf2; box-shadow: 0 10rpx 26rpx rgba(63,52,41,.06); }
.thinking { color: #858178 !important; }
.dots { letter-spacing: 5rpx; }
.chat-error { margin-bottom: 20rpx; }
.chat-bottom { height: 30rpx; }

.composer { display: flex; align-items: flex-end; gap: 14rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(71,82,73,.15); background: rgba(248,242,233,.97); }
.question-input { box-sizing: border-box; flex: 1; min-height: 78rpx; max-height: 180rpx; padding: 19rpx 22rpx; border: 1rpx solid rgba(71,82,73,.18); border-radius: 5rpx; color: #465149; background: #fffaf2; font-size: 26rpx; line-height: 1.5; }
.send-button { width: 112rpx; min-height: 78rpx; margin: 0; padding: 0; border-radius: 5rpx; color: #fff8ed; background: linear-gradient(135deg,#81343a,#5d292d); font-size: 25rpx; line-height: 78rpx; }
.send-button[disabled] { color: #b9b1a8; background: #e5ddd4; }
