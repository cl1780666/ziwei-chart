.match-page { padding-top: 0; }
.match-masthead { position: relative; height: 300rpx; margin: 0 -28rpx; overflow: hidden; }
.match-masthead image, .mast-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.mast-shade { background: linear-gradient(90deg,rgba(37,46,38,.8),rgba(37,46,38,.2)); }
.mast-copy { position: relative; padding: 52rpx 38rpx; color: #fff8ea; }
.mast-copy text { display: block; }
.eyebrow { font-size: 20rpx; letter-spacing: 5rpx; opacity: .72; }
.mast-title { margin-top: 28rpx; font-family: "Songti SC",serif; font-size: 40rpx; font-weight: 700; letter-spacing: 3rpx; }
.mast-note { margin-top: 18rpx; font-size: 23rpx; opacity: .8; }
.privacy-note { margin: 26rpx 4rpx; color: #8d8172; font-size: 22rpx; line-height: 1.7; }
.person-card { margin-top: 24rpx; padding: 30rpx; }
.person-heading { display: flex; align-items: center; justify-content: space-between; padding-bottom: 18rpx; border-bottom: 1rpx solid rgba(71,82,73,.12); }
.person-title { color: #48564a; font-family: "Songti SC",serif; font-size: 32rpx; font-weight: 700; }
.person-seal { display: flex; align-items: center; justify-content: center; width: 45rpx; height: 45rpx; border: 1rpx solid #9b6967; color: #8a4647; font-family: serif; font-size: 24rpx; }
.field { margin-top: 24rpx; }
.field-label { display: block; color: #465148; font-size: 25rpx; font-weight: 600; }
.picker-value, .text-input { box-sizing: border-box; width: 100%; min-height: 82rpx; margin-top: 12rpx; padding: 0 22rpx; border: 1rpx solid rgba(71,82,73,.17); border-radius: 6rpx; background: #f8f1e7; color: #414a43; font-size: 27rpx; }
.picker-value { display: flex; align-items: center; justify-content: space-between; }
.text-input { line-height: 82rpx; }
.gender-row { display: flex; gap: 16rpx; margin-top: 12rpx; }
.gender-option { display: flex; flex: 1; align-items: center; justify-content: center; min-height: 80rpx; border: 1rpx solid rgba(71,82,73,.15); border-radius: 6rpx; background: #faf4eb; font-size: 27rpx; }
.gender-option.selected { border-color: rgba(127,48,54,.4); background: #f4e8e3; }
.solar-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 28rpx; }
.field-hint { display: block; margin-top: 7rpx; color: #94887a; font-size: 21rpx; }
.preview-button { margin-top: 24rpx; border-radius: 7rpx; font-size: 27rpx; }
.summary-grid { margin-top: 24rpx; }
.summary-card { padding: 26rpx; margin-top: 14rpx; border-left: 5rpx solid #7e8c79; }
.summary-card text { display: block; }
.summary-label { margin-bottom: 14rpx; color: #7f3036; font-size: 25rpx; font-weight: 600; }
.summary-line { color: #4d574c; font-size: 24rpx; line-height: 1.8; }
.summary-small { margin-top: 10rpx; color: #918475; font-size: 21rpx; line-height: 1.5; }
.analyze-button { margin-top: 30rpx; border-radius: 7rpx; font-size: 28rpx; }
.allowance { display: block; margin: 16rpx 6rpx 0; color: #968777; font-size: 22rpx; line-height: 1.6; text-align: center; }
.progress-note { display: flex; align-items: center; gap: 14rpx; margin-top: 22rpx; padding: 22rpx; color: #5e705f; background: rgba(103,128,105,.09); font-size: 24rpx; }
.progress-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #7f3036; animation: breathe 1.8s infinite; }
@keyframes breathe { 50% { opacity: .25; } }
.report-card { margin-top: 32rpx; padding: 30rpx; }
.report-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-bottom: 26rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid rgba(71,82,73,.13); }
.report-heading .section-title { display: block; margin-bottom: 8rpx; font-size: 32rpx; }
.cache-label { display: block; color: #978774; font-size: 21rpx; line-height: 1.6; }
.copy-button { flex-shrink: 0; margin: 0; padding: 10rpx 20rpx; border: 1rpx solid rgba(127,48,54,.17); border-radius: 4rpx; color: #7f3036; background: #f6e9e4; font-size: 22rpx; line-height: 1.6; }
.report-block { display: block; margin: 20rpx 0; color: #505a50; font-size: 27rpx; line-height: 1.9; white-space: pre-wrap; word-break: break-word; }
.report-subheading { color: #485a49; font-family: "Songti SC",serif; font-size: 30rpx; font-weight: 700; }
.report-footnote { display: block; padding-top: 24rpx; border-top: 1rpx solid rgba(71,82,73,.12); color: #a08c79; font-size: 21rpx; line-height: 1.7; }
.loading-note { color: #827e71; font-size: 26rpx; }
