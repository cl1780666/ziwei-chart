.home-page {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 100vh;
  padding: 0;
  overflow: hidden;
  background: #e8dac9;
}

.poster-bg,
.poster-wash {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.poster-bg {
  z-index: 0;
  transform: scale(1.045);
  animation: poster-drift 14s ease-in-out infinite alternate;
}

.poster-bg-incoming {
  z-index: 1;
  opacity: 0;
  transition: opacity 1800ms ease;
}

.poster-bg-incoming.is-visible { opacity: 1; }

@keyframes poster-drift {
  from { transform: scale(1.045) translate3d(-.4%, 0, 0); }
  to { transform: scale(1.085) translate3d(.8%, -.6%, 0); }
}

.poster-wash {
  z-index: 2;
  background:
    linear-gradient(180deg, rgba(255, 248, 238, .72) 0%, rgba(255, 246, 234, .12) 42%, rgba(255, 246, 234, 0) 55%),
    linear-gradient(180deg, rgba(36, 35, 31, 0) 46%, rgba(30, 28, 25, .38) 73%, rgba(30, 26, 23, .72) 100%);
}

.poster-copy {
  position: absolute;
  z-index: 3;
  top: 54rpx;
  left: 42rpx;
  right: 42rpx;
}

.poster-meta {
  display: flex;
  align-items: center;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(74, 69, 61, .28);
  color: #585a52;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.title,
.poster-subtitle,
.quote,
.intro {
  display: block;
}

.title {
  margin-top: 34rpx;
  color: #483b36;
  font-family: "Songti SC", "STSong", serif;
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.poster-subtitle {
  margin-top: 12rpx;
  color: #74675e;
  font-family: "Songti SC", "STSong", serif;
  font-size: 25rpx;
  letter-spacing: 6rpx;
}

.bottom-sheet {
  position: relative;
  z-index: 4;
  margin: 0 24rpx calc(24rpx + env(safe-area-inset-bottom));
  padding: 22rpx 24rpx 18rpx;
  border: 1rpx solid rgba(255, 248, 238, .6);
  border-radius: 12rpx;
  background: rgba(247, 239, 228, .88);
  box-shadow: 0 24rpx 70rpx rgba(24, 20, 18, .24);
}

.quote-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #7e3036;
  font-family: "Songti SC", "STSong", serif;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.quote-place {
  color: #7b786f;
  font-family: sans-serif;
  font-size: 17rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.quote {
  display: -webkit-box;
  height: 78rpx;
  margin-top: 12rpx;
  overflow: hidden;
  color: #474943;
  font-family: "Songti SC", "STSong", serif;
  font-size: 26rpx;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  transition: opacity 220ms ease, transform 220ms ease;
}

.quote.is-visible { opacity: 1; transform: translateY(0); }
.quote.is-hidden { opacity: 0; transform: translateY(8rpx); }

.start-button {
  min-height: 82rpx;
  margin-top: 14rpx;
  border-radius: 8rpx;
  font-size: 27rpx;
  letter-spacing: 4rpx;
}

.profile-pill {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(72, 75, 68, .15);
  color: #676b63;
  font-size: 22rpx;
}

.intro {
  margin-top: 14rpx;
  color: #77776f;
  font-size: 23rpx;
  line-height: 1.6;
}

.shortcut-row {
  display: flex;
  gap: 14rpx;
  margin-top: 12rpx;
}

.shortcut {
  flex: 1;
  min-height: 76rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.sheet-signature {
  display: block;
  margin-top: 14rpx;
  color: #989085;
  font-size: 17rpx;
  letter-spacing: 2rpx;
}

.error-card {
  position: relative;
  z-index: 5;
  margin: 0 24rpx 24rpx;
}
