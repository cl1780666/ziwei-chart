.home-page {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 100vh;
  padding: 0;
  overflow: hidden;
  background: #e8dac9;
}

.poster-bg,
.poster-wash {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.poster-wash {
  z-index: 1;
  background:
    linear-gradient(180deg, rgba(255, 248, 238, .16) 0%, rgba(255, 246, 234, 0) 42%),
    linear-gradient(180deg, rgba(36, 35, 31, 0) 46%, rgba(30, 28, 25, .38) 73%, rgba(30, 26, 23, .72) 100%);
}

.poster-copy {
  position: absolute;
  z-index: 2;
  top: 54rpx;
  left: 42rpx;
  right: 42rpx;
}

.poster-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(74, 69, 61, .28);
  color: #585a52;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.title,
.poster-subtitle,
.quote,
.intro {
  display: block;
}

.title {
  margin-top: 34rpx;
  color: #483b36;
  font-family: "Songti SC", "STSong", serif;
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.poster-subtitle {
  margin-top: 12rpx;
  color: #74675e;
  font-family: "Songti SC", "STSong", serif;
  font-size: 25rpx;
  letter-spacing: 6rpx;
}

.seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-top: 28rpx;
  border: 3rpx solid rgba(128, 45, 50, .76);
  color: #812e34;
  font-family: serif;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  transform: rotate(-4deg);
}

.bottom-sheet {
  position: relative;
  z-index: 3;
  margin: 0 24rpx calc(24rpx + env(safe-area-inset-bottom));
  padding: 28rpx 28rpx 24rpx;
  border: 1rpx solid rgba(255, 248, 238, .6);
  border-radius: 12rpx;
  background: rgba(247, 239, 228, .93);
  box-shadow: 0 24rpx 70rpx rgba(24, 20, 18, .24);
}

.quote-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #7e3036;
  font-family: "Songti SC", "STSong", serif;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.quote-place {
  color: #7b786f;
  font-family: sans-serif;
  font-size: 17rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.quote {
  min-height: 82rpx;
  margin-top: 18rpx;
  color: #474943;
  font-family: "Songti SC", "STSong", serif;
  font-size: 28rpx;
  line-height: 1.65;
}

.start-button {
  margin-top: 24rpx;
  border-radius: 8rpx;
  letter-spacing: 4rpx;
}

.profile-pill {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(72, 75, 68, .15);
  color: #676b63;
  font-size: 22rpx;
}

.intro {
  margin-top: 20rpx;
  color: #77776f;
  font-size: 23rpx;
  line-height: 1.6;
}

.shortcut-row {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.shortcut {
  flex: 1;
  min-height: 76rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.sheet-signature {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
  color: #989085;
  font-size: 17rpx;
  letter-spacing: 2rpx;
}

.error-card {
  position: relative;
  z-index: 4;
  margin: 0 24rpx 24rpx;
}
