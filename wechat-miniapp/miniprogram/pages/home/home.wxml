<view class="page-shell home-page">
  <image class="poster-bg poster-bg-base" src="{{heroImages[visibleHeroIndex]}}" mode="aspectFill" />
  <image class="poster-bg poster-bg-incoming {{incomingVisible ? 'is-visible' : ''}}" src="{{heroImages[incomingHeroIndex]}}" mode="aspectFill" />
  <view class="poster-wash"></view>

  <view class="poster-copy">
    <view class="poster-meta">
      <text>皖南 · 弦上星河</text>
    </view>
    <text class="title">欢迎蕾蕾大王</text>
    <text class="poster-subtitle">山水入弦，星辰有信</text>
  </view>

  <view class="bottom-sheet">
    <view class="quote-heading">
      <text>蕾言蕾语</text>
      <text class="quote-place">WANNAN · ANHUI</text>
    </view>
    <text class="quote {{quoteVisible ? 'is-visible' : 'is-hidden'}}">“{{quote}}”</text>

    <button class="primary-button start-button" bindtap="start" disabled="{{loading || clearing}}">
      {{hasProfile ? '打开完整命盘' : '开始测一测'}}
    </button>

    <view wx:if="{{hasProfile}}" class="profile-pill">
      <text>资料已存本机</text>
      <text>今日余 {{remaining}} 问</text>
    </view>
    <text wx:else class="intro">将生辰落于纸上，慢慢展开十二宫。</text>

    <view wx:if="{{hasProfile}}" class="shortcut-grid">
      <button class="secondary-button shortcut" data-feature="fortune" bindtap="openFeature">年度运势</button>
      <button class="secondary-button shortcut" data-feature="kline" bindtap="openFeature">人生 K 线</button>
      <button class="secondary-button shortcut" data-feature="match" bindtap="openFeature">双人合盘</button>
      <button class="secondary-button shortcut" data-feature="chat" bindtap="openFeature">星图问答</button>
      <button class="secondary-button shortcut" data-feature="share" bindtap="openFeature">分享卡片</button>
      <button class="secondary-button shortcut" bindtap="openProfile">修改资料</button>
    </view>
    <view class="sheet-signature">
      <text>资料与聊天仅存本机</text>
      <button class="privacy-clear" bindtap="clearLocalData" loading="{{clearing}}" disabled="{{loading || clearing}}">清除本机数据</button>
    </view>
  </view>

  <view wx:if="{{error}}" class="error-card">{{error}}</view>
</view>
<music-control />
